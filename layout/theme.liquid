<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- comment -%}
      Ce drapeau doit etre pose avant la premiere peinture.

      Plusieurs composants KINU sont ecrits pour rester utilisables sans
      JavaScript : le panneau de filtres, par exemple, est d'abord un bloc
      statique dans le flux de la page, et ne devient un tiroir lateral que
      lorsque son script s'execute. Or ce script est differe. Entre l'analyse
      de la page et son execution, le panneau se peignait donc en entier, puis
      glissait vers la droite en 560 ms, a chaque chargement de page catalogue.

      Un script synchrone place ici tranche la question avant le premier pixel :
      le navigateur sait des le depart s'il execute du JavaScript, et le panneau
      nait tiroir. Sans JavaScript, le drapeau est absent et le bloc statique
      reste, avec son formulaire qui fonctionne seul.
    {%- endcomment -%}
    <script>document.documentElement.setAttribute('data-kn-js', '');</script>

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %}
      Opt into cross-document (MPA) view transitions and hold first paint until #MainContent
      parses, so the transition runs consistently.
      Both are gated on the same settings as the view-transitions.js opt-out switch (see snippets/scripts.liquid).
    {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      {% style %}
        @media (prefers-reduced-motion: no-preference) {
          @view-transition {
            navigation: auto;
          }
        }
      {% endstyle %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {%- comment -%}
      Surcouche de direction artistique KINŪ — doit rester en dernier pour
      l'emporter sur les feuilles du thème. L'ordre est significatif :
      jetons → socle → feuilles de domaine.
    {%- endcomment -%}
    {{ 'custom.css' | asset_url | stylesheet_tag }}
    {{ 'kn-base.css' | asset_url | stylesheet_tag }}
    {{ 'kn-chrome.css' | asset_url | stylesheet_tag }}
    {{ 'kn-home.css' | asset_url | stylesheet_tag }}
    {{ 'kn-catalog.css' | asset_url | stylesheet_tag }}
    {{ 'kn-product.css' | asset_url | stylesheet_tag }}
    {%- comment -%}
      En dernier : cette feuille ne peint que des composants d'Horizon, sur les
      pages que le systeme KINU ne rend pas lui-meme.
    {%- endcomment -%}
    {{ 'kn-horizon.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'kn-base.js' | asset_url }}" defer></script>
    <script src="{{ 'kn-chrome.js' | asset_url }}" defer></script>
    <script src="{{ 'kn-home.js' | asset_url }}" defer></script>
    <script src="{{ 'kn-catalog.js' | asset_url }}" defer></script>
    <script src="{{ 'kn-product.js' | asset_url }}" defer></script>

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  {%- comment -%}
    Territoire de collection KINŪ (DIRECTION-ARTISTIQUE.md §3.4 R3).
    Chaque univers de marque colore la page de collection qui lui correspond :
    Fluid-Motion → ivoire, CrossOver → encre, Amplitude → vert forêt.
    L'attribut est lu par `custom.css`, qui bascule la surface du <main>.
  {%- endcomment -%}
  {%- liquid
    assign kn_universes = 'fluid-motion,crossover,amplitude' | split: ','
    assign kn_territory = ''
    if collection.handle != blank and kn_universes contains collection.handle
      assign kn_territory = collection.handle
    endif
    if kn_territory == blank and product != blank
      for kn_collection in product.collections
        if kn_universes contains kn_collection.handle
          assign kn_territory = kn_collection.handle
          break
        endif
      endfor
    endif
  -%}

  <body
    class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}"
    {% if kn_territory != blank %}data-kn-territory="{{ kn_territory }}"{% endif %}
  >
    {%- comment -%}
      Premiere barriere — le panier ne suit pas le visiteur d'une page a l'autre.

      Horizon rouvre volontairement, au-dela de 990 px, tout tiroir laisse
      ouvert : un script synchrone relit `theme-drawer-open` pendant l'analyse
      de la page et repose l'attribut `open` avant la premiere peinture. Chez
      KINU le panier n'est pas une colonne qui accompagne les achats, c'est un
      tiroir pose sur la page.

      On efface la cle avant que ce script ne la lise. Ce bloc doit donc rester
      le tout premier du corps : c'est la seule barriere qui precede toutes les
      autres. Les autres tiroirs gardent leur memoire.
    {%- endcomment -%}
    <script>
      try {
        var knNoms = (sessionStorage.getItem('theme-drawer-open') || '').split(',');
        var knGardes = [];
        for (var knI = 0; knI < knNoms.length; knI++) {
          if (knNoms[knI] && knNoms[knI] !== 'cart-drawer') knGardes.push(knNoms[knI]);
        }
        if (knGardes.length) {
          sessionStorage.setItem('theme-drawer-open', knGardes.join(','));
        } else {
          sessionStorage.removeItem('theme-drawer-open');
        }
      } catch (knErr) {}
    </script>

    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        // Inline header height and menu style calculations to prevent layout shift
        // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
        (function setHeaderHeighCustomProperties() {
          /*
           * Header calculation functions for maintaining CSS variables
           * Mimic calculateHeaderGroupHeight() in utilities.js
           */
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section');

          if (!header || !headerGroup) return;

          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;

          // Calculate the total height of the header group
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }

          // Check for transparent header special case
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }

          // Set CSS variables
          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }

          /**
           * Updates CSS custom properties for transparent header offset calculation
           * Mimic updateTransparentHeaderOffset() in utilities.js
           */

          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }

          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout kn-territory-surface"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>


    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {%- comment -%}
      Seconde barriere — filet de securite.

      La premiere couvre la cause connue. Celle-ci couvre les autres : si quoi
      que ce soit a ouvert le panier pendant l'analyse de la page, on le
      referme des que le composant devient disponible, et on retire le decalage
      de page qui l'accompagne. Un panier ouvert au chargement n'est jamais
      voulu ; seul un clic doit l'ouvrir.
    {%- endcomment -%}
    <script>
      (function () {
        function knFerme() {
          var tiroir = document.getElementById('cart-drawer');
          if (!tiroir) return;
          var panneau = tiroir.querySelector('dialog');
          var ouvert = tiroir.hasAttribute('open') || (panneau && panneau.hasAttribute('open'));
          if (!ouvert) return;

          tiroir.removeAttribute('open');
          if (panneau) {
            panneau.classList.remove(
              'theme-drawer__dialog-instant',
              'theme-drawer__dialog--opening',
              'theme-drawer__dialog--opening-inline-start'
            );
            if (panneau.open) panneau.close();
            else panneau.removeAttribute('open');
          }
          tiroir.style.removeProperty('--drawer-stack-order');

          var enveloppe = document.querySelector('.page-wrapper');
          if (enveloppe && !document.querySelector('theme-drawer[open]')) {
            enveloppe.classList.remove('page-wrapper--drawer-open');
          }
        }

        knFerme();
        document.addEventListener('DOMContentLoaded', knFerme);
        if (window.customElements) {
          customElements.whenDefined('theme-drawer').then(knFerme);
        }
      })();
    </script>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
