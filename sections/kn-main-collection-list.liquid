{%- liquid
  comment
    « Toutes les collections » (DIRECTION-ARTISTIQUE.md §3.4 R1/R3, §6).
    Ce n’est pas une grille de vignettes : chaque univers occupe une bande
    pleine largeur qui raconte son nom et préfigure la surface de son
    territoire. Le client fidèle vient ici pour l’histoire, pas pour naviguer.
  endcomment
  assign kn_settings = section.settings
  assign kn_sizes = '(min-width: 1024px) min(700px, 46vw), calc(100vw - 32px)'
  assign kn_widths = '400,600,800,1000,1200,1400'
-%}

<div class="kn-catalog kn-collections">
  <header class="kn-section kn-container kn-collections__head">
    {%- if kn_settings.show_breadcrumb -%}
      {%- render 'kn-breadcrumb', current_title: kn_settings.title -%}
    {%- endif -%}
    {%- if kn_settings.eyebrow != blank -%}
      <p class="kn-label kn-collections__eyebrow">{{ kn_settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="kn-collections__title">{{ kn_settings.title }}</h1>
    {%- if kn_settings.intro != blank -%}
      <p class="kn-lead kn-collections__intro">{{ kn_settings.intro }}</p>
    {%- endif -%}
  </header>

  {%- for kn_block in section.blocks -%}
    {%- liquid
      assign kn_target = kn_block.settings.collection
      assign kn_image = kn_block.settings.image | default: kn_target.featured_image
      assign kn_heading = kn_block.settings.title | default: kn_target.title
      assign kn_eyebrow = kn_block.settings.eyebrow | default: kn_target.title
      assign kn_cta = kn_block.settings.link_label
      if kn_cta == blank
        assign kn_cta = 'Voir ' | append: kn_target.title
      endif
      assign kn_lazy = 'lazy'
      if forloop.first
        assign kn_lazy = 'eager'
      endif
    -%}

    <section
      class="kn-section kn-story kn-story--media-{{ kn_block.settings.media_position }}{% unless kn_image %} kn-story--no-media{% endunless %}"
      data-kn-surface="{{ kn_block.settings.surface }}"
      {{ kn_block.shopify_attributes }}
    >
      <div class="kn-container kn-story__inner">
        {%- if kn_image != blank -%}
          <div class="kn-story__media kn-reveal">
            <span class="kn-ratio kn-story__frame">
              {{
                kn_image
                | image_url: width: 1400
                | image_tag:
                  class: 'kn-img',
                  widths: kn_widths,
                  sizes: kn_sizes,
                  loading: kn_lazy,
                  alt: kn_heading
              }}
            </span>
          </div>
        {%- endif -%}

        <div class="kn-story__body kn-reveal">
          {%- if kn_eyebrow != blank -%}
            <p class="kn-label kn-story__eyebrow">{{ kn_eyebrow }}</p>
          {%- endif -%}
          <h2 class="kn-story__title">{{ kn_heading }}</h2>
          {%- if kn_block.settings.story != blank -%}
            <div class="kn-story__text kn-measure">{{ kn_block.settings.story }}</div>
          {%- endif -%}
          {%- if kn_target != blank -%}
            <a class="kn-btn kn-btn--secondary kn-story__cta" href="{{ kn_target.url }}">{{ kn_cta }}</a>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Collections KINŪ",
  "class": "kn-section-collections",
  "enabled_on": { "templates": ["list-collections"] },
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Afficher le fil d’Ariane", "default": false, "info": "Page de premier niveau : le fil ne dirait que « Accueil / Toutes les collections »." },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Les univers KINŪ" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Toutes les collections" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Trois noms, trois façons de bouger. Chaque univers porte sa propre couleur : vous la retrouverez en entrant dans sa collection." }
  ],
  "blocks": [
    {
      "type": "universe",
      "name": "Univers",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "eyebrow", "label": "Sur-titre", "info": "Le nom de la collection. Par défaut, le titre Shopify." },
        { "type": "text", "id": "title", "label": "Titre", "info": "La catégorie : Femme, Homme, Unisexe." },
        { "type": "richtext", "id": "story", "label": "Récit", "info": "D’où vient le nom, ce qu’il désigne. Trois à cinq lignes." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait 4:5. Par défaut, l’image de la collection." },
        { "type": "text", "id": "link_label", "label": "Libellé du lien", "info": "Par défaut : « Voir » suivi du nom de la collection." },
        {
          "type": "select",
          "id": "surface",
          "label": "Surface",
          "options": [
            { "value": "light", "label": "Ivoire" },
            { "value": "sage", "label": "Sauge" },
            { "value": "dark", "label": "Encre" },
            { "value": "flood", "label": "Forêt" }
          ],
          "default": "light",
          "info": "Doit reprendre la surface du territoire de la collection."
        },
        {
          "type": "select",
          "id": "media_position",
          "label": "Position de l’image",
          "options": [
            { "value": "start", "label": "À gauche" },
            { "value": "end", "label": "À droite" }
          ],
          "default": "start"
        }
      ]
    }
  ],
  "presets": []
}
{% endschema %}
