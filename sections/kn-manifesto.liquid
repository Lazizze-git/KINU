{%- comment -%}
  KINŪ — Manifeste (inondation 1, DA §3.4 R1).

  Refonte du 22 septembre 2026, demande client : les trois preuves deviennent
  des plaques de verre dépoli posées sur un fond vivant. Sur téléphone, elles
  s'empilent au défilement ; sur ordinateur, elles tiennent une rangée et un
  reflet suit le pointeur (kn-manifesto.js).

  Le fond est une photographie si elle est réglée, sinon trois halos de lumière
  aux couleurs de la marque — jamais d'image de maquette, le verre doit avoir
  quelque chose à flouter sans rien emprunter.
{%- endcomment -%}

{{ 'kn-manifesto.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kn-manifesto.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign show_cta = false
  if s.link_label != blank and s.link_url != blank
    assign show_cta = true
  endif
-%}

<div class="kn-section kn-manifesto" data-kn-surface="flood" data-kn-manifesto>
  <div class="kn-manifesto__backdrop" aria-hidden="true">
    {%- if s.image != blank -%}
      {{
        s.image
        | image_url: width: 2400
        | image_tag:
          widths: '640, 828, 1080, 1440, 1920, 2400',
          sizes: '100vw',
          class: 'kn-manifesto__photo',
          alt: '',
          loading: 'lazy'
      }}
    {%- else -%}
      <span class="kn-manifesto__halo kn-manifesto__halo--1"></span>
      <span class="kn-manifesto__halo kn-manifesto__halo--2"></span>
      <span class="kn-manifesto__halo kn-manifesto__halo--3"></span>
    {%- endif -%}
  </div>

  <div class="kn-container kn-manifesto__inner">
    <div class="kn-manifesto__head">
      <div class="kn-reveal">
        <h2 class="kn-manifesto__title">{{ s.title | escape }}</h2>
      </div>

      <div class="kn-manifesto__aside kn-reveal">
        {%- if s.text != blank -%}
          <p class="kn-lead">{{ s.text | escape }}</p>
        {%- endif -%}
        {%- if show_cta -%}
          <a class="kn-btn kn-btn--primary" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="kn-manifesto__pillars" role="list">
        {%- for block in section.blocks -%}
          <li
            class="kn-manifesto__pillar kn-reveal"
            style="--kn-i: {{ forloop.index0 }}; --kn-reveal-delay: {{ forloop.index0 | times: 80 }}ms;"
            data-kn-glass
            {{ block.shopify_attributes }}
          >
            <span class="kn-manifesto__key">{{ block.settings.key | escape }}</span>
            {%- if block.settings.text != blank -%}
              <p class="kn-manifesto__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Manifeste",
  "tag": "section",
  "class": "kn-manifesto-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Peu de pièces, pensées pour durer une décennie."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraphe",
      "default": "Petites séries, ateliers européens : nous préférons une coupe juste à une nouveauté de plus."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Libellé du bouton",
      "default": "NOTRE FABRICATION"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Destination du bouton"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo de fond",
      "info": "Facultatif. Vue à travers les cartes en verre, teintée de vert. Sans photo, le fond est fait de halos de lumière verts."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilier",
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Chiffre ou mot-clé",
          "default": "Suisse"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Ligne d'explication",
          "default": "Conception et prototypage à Lausanne."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KINŪ — Manifeste",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "key": "Suisse",
            "text": "Conception et prototypage à Lausanne."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "key": "1 saison",
            "text": "De test en conditions réelles avant toute mise en production."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "key": "5 ans",
            "text": "De réparation gratuite sur les coutures et les fermetures."
          }
        }
      ]
    }
  ]
}
{% endschema %}
