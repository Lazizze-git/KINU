{%- comment -%}
  KINŪ — Manifeste (inondation 1, DA §3.4 R1).

  Refonte du 22 septembre 2026, demande client, affinée le jour même : les
  trois preuves tiennent dans une seule plaque claire posée sur l'aplat forêt
  uni, découpée par des filets — en lignes sur téléphone, en colonnes sur
  ordinateur. Un reflet suit le pointeur (kn-manifesto.js).

  5 octobre 2026 : les chiffres sont devenus des mots-clés, en DM Sans 500
  (déjà chargée par le thème) ; la graisse légère n'est plus chargée ici.
{%- endcomment -%}

{{ 'kn-manifesto.css' | asset_url | stylesheet_tag }}

<script src="{{ 'kn-manifesto.js' | asset_url }}" defer></script>

{%- comment -%}
  Typographie française : « et » restent collés au mot qu'ils encadrent, et
  : ; ! ? ne passent jamais seuls en début de ligne. Le texte saisi dans
  l'éditeur reste tel quel, seules les espaces deviennent insécables.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign kn_title = s.title | escape | replace: '« ', '«&nbsp;' | replace: ' »', '&nbsp;»' | replace: ' :', '&nbsp;:' | replace: ' ;', '&nbsp;;' | replace: ' !', '&nbsp;!' | replace: ' ?', '&nbsp;?'
  assign kn_text = s.text | escape | replace: '« ', '«&nbsp;' | replace: ' »', '&nbsp;»' | replace: ' :', '&nbsp;:' | replace: ' ;', '&nbsp;;' | replace: ' !', '&nbsp;!' | replace: ' ?', '&nbsp;?'
  assign show_cta = false
  if s.link_label != blank and s.link_url != blank
    assign show_cta = true
  endif
-%}

<div class="kn-section kn-manifesto" data-kn-surface="flood" data-kn-manifesto>
  <div class="kn-container kn-manifesto__inner">
    <div class="kn-manifesto__head">
      <div class="kn-reveal">
        <h2 class="kn-manifesto__title">{{ kn_title }}</h2>
      </div>

      <div class="kn-manifesto__aside kn-reveal">
        {%- if s.text != blank -%}
          <p class="kn-lead">{{ kn_text }}</p>
        {%- endif -%}
        {%- if show_cta -%}
          <a class="kn-btn kn-btn--primary" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul
        class="kn-manifesto__pillars"
        role="list"
        style="--kn-pillar-count: {{ section.blocks.size }};"
        data-kn-glass
      >
        {%- for block in section.blocks -%}
          {%- assign kn_pillar_text = block.settings.text | escape | replace: '« ', '«&nbsp;' | replace: ' »', '&nbsp;»' | replace: ' :', '&nbsp;:' | replace: ' ;', '&nbsp;;' | replace: ' !', '&nbsp;!' | replace: ' ?', '&nbsp;?' -%}
          <li
            class="kn-manifesto__pillar kn-reveal"
            style="--kn-reveal-delay: {{ forloop.index0 | times: 90 }}ms;"
            {{ block.shopify_attributes }}
          >
            <span class="kn-manifesto__key">{{ block.settings.key | escape }}</span>
            {%- if block.settings.text != blank -%}
              <p class="kn-manifesto__text">{{ kn_pillar_text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Manifeste",
  "tag": "section",
  "class": "kn-manifesto-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Peu de pièces, pensées pour durer une décennie."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraphe",
      "default": "Petites séries, ateliers européens : nous préférons une coupe juste à une nouveauté de plus."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Libellé du bouton",
      "default": "NOTRE FABRICATION"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Destination du bouton"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilier",
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Chiffre ou mot-clé",
          "default": "Suisse"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Ligne d'explication",
          "default": "Conception et prototypage à Lausanne."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KINŪ — Manifeste",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "key": "Suisse",
            "text": "Conception et prototypage à Lausanne."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "key": "1 saison",
            "text": "De test en conditions réelles avant toute mise en production."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "key": "5 ans",
            "text": "De réparation gratuite sur les coutures et les fermetures."
          }
        }
      ]
    }
  ]
}
{% endschema %}
