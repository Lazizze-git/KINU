{%- comment -%}
  KINŪ — Page « Bientôt en ligne » (page mot de passe)

  Tant que la boutique est protégée par mot de passe, c'est la seule page que
  voit un visiteur. Surface inondée (vert forêt) bord à bord, le symbole en
  filigrane, une inscription pour être prévenu du lancement.

  Les inscrits sont créés comme clients Shopify avec les étiquettes
  `newsletter` et `lancement`, pour l'e-mail d'ouverture.

  « Accès privé » ouvre la fenêtre de mot de passe de layout/password.liquid
  (#password-form), qui remplace le pied de page Horizon.
{%- endcomment -%}

<div class="kn-soon" data-kn-surface="flood" {{ section.shopify_attributes }}>
  {%- render 'kn-brand-mark', name: 'symbol', class: 'kn-soon__watermark' -%}

  <header class="kn-soon__bar">
    <span class="kn-soon__brand" role="img" aria-label="{{ shop.name | escape }}">
      {%- render 'kn-brand-mark', name: 'logotype', class: 'kn-soon__logotype' -%}
    </span>

    {%- if section.settings.access_label != blank -%}
      <button type="button" class="kn-label kn-soon__link" on:click="#password-form/showDialog">
        {{- section.settings.access_label | escape -}}
      </button>
    {%- endif -%}
  </header>

  <div class="kn-soon__body">
    {%- render 'kn-brand-mark', name: 'symbol', class: 'kn-soon__symbol' -%}

    {%- if section.settings.kicker != blank -%}
      <p class="kn-label kn-soon__kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}

    <h1 class="kn-soon__title">{{ section.settings.title | escape | newline_to_br }}</h1>

    {%- if section.settings.lead != blank or section.settings.text != blank -%}
      <p class="kn-soon__lead">
        {{- section.settings.lead | escape -}}
        {%- if section.settings.text != blank -%}
          <span class="kn-soon__text">{{ section.settings.text | escape }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- form 'customer', id: 'kn-soon-signup', class: 'kn-soon__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,lancement">

      {%- if form.posted_successfully? -%}
        <p class="kn-soon__feedback" role="status">{{ section.settings.success | escape }}</p>
      {%- else -%}
        <div class="kn-soon__field">
          <label class="kn-visually-hidden" for="kn-soon-email">{{ section.settings.placeholder | escape }}</label>
          <input
            class="kn-soon__input"
            id="kn-soon-email"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.placeholder | escape }}"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            required
            {% if form.errors %}
              aria-invalid="true" aria-describedby="kn-soon-error"
            {% endif %}
          >
          <button type="submit" class="kn-btn kn-btn--primary kn-soon__submit">
            {{- section.settings.cta | escape -}}
          </button>
        </div>

        {%- if form.errors -%}
          <p class="kn-soon__feedback" id="kn-soon-error" role="alert">{{ section.settings.error | escape }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>

  <footer class="kn-soon__foot">
    <span class="kn-label">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>

    <div class="kn-soon__foot-links">
      {%- if section.settings.instagram != blank -%}
        <a class="kn-label kn-soon__link" href="{{ section.settings.instagram }}" target="_blank" rel="noopener">
          Instagram ↗
        </a>
      {%- endif -%}
      {%- if section.settings.signature != blank -%}
        <span class="kn-label">{{ section.settings.signature | escape }}</span>
      {%- endif -%}
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "KINŪ · Bientôt en ligne",
  "tag": "section",
  "class": "kn-soon-section",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "kicker", "label": "Libellé", "default": "Lancement prochain" },
    {
      "type": "textarea",
      "id": "title",
      "label": "Titre",
      "info": "Un retour à la ligne dans le champ crée un retour à la ligne sur la page.",
      "default": "Bientôt\nen ligne."
    },
    { "type": "text", "id": "lead", "label": "Accroche", "default": "Le vêtement technique, à l’échelle du geste." },
    { "type": "text", "id": "text", "label": "Texte d'accompagnement", "default": "Laisse ton e-mail, on te prévient dès l’ouverture." },
    { "type": "header", "content": "Inscription" },
    { "type": "text", "id": "placeholder", "label": "Champ e-mail", "default": "Adresse e-mail" },
    { "type": "text", "id": "cta", "label": "Bouton", "default": "Me prévenir" },
    {
      "type": "text",
      "id": "success",
      "label": "Message de confirmation",
      "default": "Merci, on te prévient dès l’ouverture."
    },
    {
      "type": "text",
      "id": "error",
      "label": "Message d'erreur",
      "default": "Cette adresse e-mail n’a pas pu être enregistrée."
    },
    { "type": "header", "content": "Liens" },
    {
      "type": "text",
      "id": "access_label",
      "label": "Lien vers le mot de passe",
      "info": "Ouvre la fenêtre pour entrer le mot de passe de la boutique.",
      "default": "Accès privé"
    },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "text", "id": "signature", "label": "Mention en bas de page", "default": "KINŪ signifie « soie »" }
  ]
}
{% endschema %}
