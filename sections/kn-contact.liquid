{{ 'kn-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  comment
    Demande client du 24 octobre : la page de contact « etait horrible ». Elle
    n'etait qu'un titre, un bloc de texte et, tout en bas, un formulaire a
    moitie de largeur dont les champs n'avaient pour libelle qu'un texte
    d'attente. Le texte de la page (Boutique en ligne, Pages, Contact) reste
    celui que le client ecrit : il se pose a gauche, le formulaire a droite.
  endcomment
  assign kn_has_content = false
  if page.content != blank
    assign kn_has_content = true
  endif

  comment
    Demande client du 6 novembre 2026 : le formulaire restait en français sur
    la version anglaise. Les réglages laissés à leur valeur par défaut ne sont
    pas enregistrés dans le modèle, donc Traduire et adapter ne les voit pas.
    Les défauts du schéma sont retirés : un champ vide prend le texte des
    fichiers de langue (kinu.contact), en français ou en anglais selon la
    langue du visiteur. Un texte saisi dans l'éditeur reste prioritaire et se
    traduit alors dans Traduire et adapter.
  endcomment
  assign kn_t_eyebrow = 'kinu.contact.eyebrow' | t
  assign kn_t_name = 'kinu.contact.name' | t
  assign kn_t_email = 'kinu.contact.email' | t
  assign kn_t_topic = 'kinu.contact.topic' | t
  assign kn_t_topic_placeholder = 'kinu.contact.topic_placeholder' | t
  assign kn_t_topics = 'kinu.contact.topics' | t
  assign kn_t_order = 'kinu.contact.order' | t
  assign kn_t_message = 'kinu.contact.message' | t
  assign kn_t_submit = 'kinu.contact.submit' | t
  assign kn_t_required = 'kinu.contact.required_note' | t
  assign kn_t_success_title = 'kinu.contact.success_title' | t
  assign kn_t_success_text = 'kinu.contact.success_text' | t
  assign kn_t_success_link = 'kinu.contact.success_link' | t
  assign kn_t_error = 'kinu.contact.error' | t
  assign kn_t_direct = 'kinu.contact.direct_title' | t

  assign kn_eyebrow = s.eyebrow | default: kn_t_eyebrow
  assign kn_label_name = s.label_name | default: kn_t_name
  assign kn_label_email = s.label_email | default: kn_t_email
  assign kn_topic_placeholder = s.topic_placeholder | default: kn_t_topic_placeholder
  assign kn_label_message = s.label_message | default: kn_t_message
  assign kn_submit = s.submit_label | default: kn_t_submit
  assign kn_required = s.required_note | default: kn_t_required
  assign kn_success_title = s.success_title | default: kn_t_success_title
  assign kn_success_text = s.success_text | default: kn_t_success_text
  assign kn_success_link = s.success_link | default: kn_t_success_link
  assign kn_error = s.error_text | default: kn_t_error
  assign kn_direct_title = s.direct_title | default: kn_t_direct

  assign kn_field_topic = s.label_topic | default: kn_t_topic
  assign kn_field_order = s.label_order | default: kn_t_order

  assign kn_topics_raw = s.topics | default: kn_t_topics
  assign kn_has_topics = false
  if kn_topics_raw != blank
    assign kn_has_topics = true
    assign kn_topics = kn_topics_raw | newline_to_br | split: '<br />'
  endif

  assign kn_has_direct = false
  if s.email != blank or s.instagram_url != blank
    assign kn_has_direct = true
  endif
-%}

<div class="kn-contact" data-kn-surface="light">
  <div class="kn-container">
    <header class="kn-contact__head">
      {%- if kn_eyebrow != blank -%}
        <p class="kn-label kn-contact__eyebrow">{{ kn_eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="kn-contact__title">{{ page.title | escape }}</h1>
    </header>

    <div class="kn-contact__grid{% unless kn_has_content %} kn-contact__grid--solo{% endunless %}">
      {%- if kn_has_content -%}
        <div class="kn-contact__text">{{ page.content }}</div>
      {%- endif -%}

      <div class="kn-contact__panel">
        {%- form 'contact', id: 'kn-contact-form', class: 'kn-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="kn-contact__done" role="status" tabindex="-1" autofocus>
              <h2 class="kn-contact__done-title">{{ kn_success_title | escape }}</h2>
              {%- if kn_success_text != blank -%}
                <p class="kn-contact__done-text">{{ kn_success_text | escape }}</p>
              {%- endif -%}
              <a class="kn-label kn-underline kn-contact__done-link" href="{{ routes.root_url }}">
                {{- kn_success_link | escape -}}
              </a>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <p class="kn-contact__error kn-sm" id="kn-contact-error" role="alert" tabindex="-1" autofocus>
                {{- kn_error | escape -}}
              </p>
            {%- endif -%}

            <div class="kn-contact__row">
              <div class="kn-field">
                <label class="kn-label kn-field__label" for="kn-contact-name">{{ kn_label_name | escape }}</label>
                <input
                  class="kn-input"
                  id="kn-contact-name"
                  type="text"
                  name="contact[name]"
                  value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                  autocomplete="name"
                >
              </div>

              <div class="kn-field">
                <label class="kn-label kn-field__label" for="kn-contact-email">
                  {{- kn_label_email | escape }} <span aria-hidden="true">*</span>
                </label>
                <input
                  class="kn-input"
                  id="kn-contact-email"
                  type="email"
                  name="contact[email]"
                  value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                  autocomplete="email"
                  spellcheck="false"
                  autocapitalize="off"
                  required
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="kn-contact-error"
                  {% endif %}
                >
              </div>
            </div>

            <div class="kn-contact__row">
              {%- if kn_has_topics -%}
                <div class="kn-field">
                  <label class="kn-label kn-field__label" for="kn-contact-topic">{{ kn_field_topic | escape }}</label>
                  <select class="kn-input kn-contact__select" id="kn-contact-topic" name="contact[{{ kn_field_topic | escape }}]">
                    <option value="">{{ kn_topic_placeholder | escape }}</option>
                    {%- for kn_raw in kn_topics -%}
                      {%- assign kn_topic = kn_raw | strip -%}
                      {%- if kn_topic != blank -%}
                        <option value="{{ kn_topic | escape }}">{{ kn_topic | escape }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}

              <div class="kn-field">
                <label class="kn-label kn-field__label" for="kn-contact-order">{{ kn_field_order | escape }}</label>
                <input
                  class="kn-input"
                  id="kn-contact-order"
                  type="text"
                  name="contact[{{ kn_field_order | escape }}]"
                  autocomplete="off"
                >
              </div>
            </div>

            <div class="kn-field">
              <label class="kn-label kn-field__label" for="kn-contact-body">
                {{- kn_label_message | escape }} <span aria-hidden="true">*</span>
              </label>
              <textarea
                class="kn-input kn-contact__textarea"
                id="kn-contact-body"
                name="contact[body]"
                rows="6"
                required
                aria-required="true"
              >
                {{- form.body -}}
              </textarea>
            </div>

            <button type="submit" class="kn-btn kn-btn--primary kn-contact__submit">
              {{- kn_submit | escape -}}
            </button>

            {%- if kn_required != blank -%}
              <p class="kn-contact__note kn-sm">{{ kn_required | escape }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        {%- if kn_has_direct -%}
          <div class="kn-contact__direct">
            {%- if kn_direct_title != blank -%}
              <p class="kn-label kn-contact__direct-title">{{ kn_direct_title | escape }}</p>
            {%- endif -%}
            <ul class="kn-contact__direct-list" role="list">
              {%- if s.email != blank -%}
                <li><a class="kn-underline" href="mailto:{{ s.email | escape }}">{{ s.email | escape }}</a></li>
              {%- endif -%}
              {%- if s.instagram_url != blank -%}
                <li>
                  <a class="kn-underline" href="{{ s.instagram_url }}" rel="noopener">
                    {{- s.instagram_label | default: s.instagram_url | escape -}}
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KINŪ · Contact",
  "tag": "section",
  "class": "kn-contact-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Le texte à gauche du formulaire s'écrit dans Boutique en ligne, Pages, Contact. Cette section règle le formulaire et les coordonnées."
    },
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "info": "Petit texte au-dessus du titre. Vide : « Nous écrire », traduit selon la langue du visiteur."
    },
    {
      "type": "header",
      "content": "Formulaire"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Champ nom",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Champ e-mail",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "label_topic",
      "label": "Champ sujet",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "topic_placeholder",
      "label": "Invite du sujet",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "textarea",
      "id": "topics",
      "label": "Sujets proposés (un par ligne)",
      "info": "Vide : liste par défaut, traduite selon la langue du visiteur. Le sujet choisi arrive dans l'e-mail que vous recevez."
    },
    {
      "type": "text",
      "id": "label_order",
      "label": "Champ numéro de commande",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Champ message",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Bouton",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "required_note",
      "label": "Mention des champs obligatoires",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Titre après envoi",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Texte après envoi",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "success_link",
      "label": "Lien après envoi",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Message d'erreur",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "header",
      "content": "Coordonnées (facultatif)"
    },
    {
      "type": "text",
      "id": "direct_title",
      "label": "Titre du bloc",
      "info": "Vide : texte par défaut, traduit selon la langue du visiteur."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Adresse e-mail affichée",
      "info": "Laissez vide pour ne pas l'afficher."
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Texte du lien Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Lien Instagram",
      "info": "Laissez vide pour ne pas l'afficher."
    }
  ]
}
{% endschema %}
