{%- comment -%}
  KINŪ — Recommandations produit.
  Recommandations natives Shopify, chargées en différé par le custom element
  `product-recommendations` d'Horizon (Section Rendering API).
  Titre sobre : un filet 1 px et un libellé, rien de plus.
{%- endcomment -%}

<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign kn_limit = section.settings.products_to_show
  assign kn_product_id = section.settings.product.id | default: product.id
-%}

<section class="kn-recos" data-kn-surface="light" {{ section.shopify_attributes }}>
  <product-recommendations
    id="KnRecos-{{ section.id }}"
    data-url="{{ routes.product_recommendations_url }}?limit={{ kn_limit }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ kn_product_id }}"
    data-intent="{{ section.settings.recommendation_type }}"
    data-recommendations-performed="{{ recommendations.performed }}"
    data-hydration-key="kn-product-recommendations-{{ section.id }}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="kn-container kn-container--narrow kn-recos__inner">
        <div class="kn-recos__head">
          <h2 class="kn-label kn-recos__title">{{ section.settings.heading }}</h2>
        </div>

        <ul class="kn-recos__grid" role="list">
          {%- for product in recommendations.products limit: kn_limit -%}
            <li class="kn-recos__item">
              {% render 'kn-product-card', product: product %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </product-recommendations>
</section>

{% schema %}
{
  "name": "Recommandations KINŪ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vous aimerez aussi" },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Type de recommandation",
      "options": [
        { "value": "related", "label": "Produits liés" },
        { "value": "complementary", "label": "Produits complémentaires" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    { "type": "product", "id": "product", "label": "Produit de référence" }
  ],
  "presets": [{ "name": "Recommandations KINŪ" }]
}
{% endschema %}
