{%- liquid
  assign s = section.settings
  assign target_collection = s.collection
  if target_collection == blank
    assign target_collection = collections.all
  endif
  assign product_count = target_collection.products.size
  assign show_link = false
  if s.link_label != blank and target_collection.url != blank
    assign show_link = true
  endif

  comment
    Le compteur de la ligne de données annonce ce qui est réellement affiché,
    pas le catalogue entier : une promesse tenue à l'écran.
  endcomment
  assign kn_shown = s.count
  if product_count < kn_shown
    assign kn_shown = product_count
  endif
-%}

<div class="kn-section" data-kn-surface="light">
  <div class="kn-container">
    <div class="kn-home-head">
      {%- render 'kn-datarow', label: s.eyebrow, count: kn_shown -%}
      <div class="kn-home-head__text">
        <h2>{{ s.title | escape }}</h2>
      </div>
      {%- if show_link -%}
        <a class="kn-label kn-underline kn-home-head__link" href="{{ target_collection.url }}">
          {{- s.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if product_count > 0 -%}
      <div class="kn-products__grid kn-home-body">
        {%- for product in target_collection.products limit: s.count -%}
          <div class="kn-reveal">
            {%- render 'kn-product-card', product: product, show_universe: true -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%}
        Catalogue vide : plutot qu'une phrase, on montre la mise en page.
        Voir snippets/kn-demo-grid.liquid — contenu de maquette a retirer.
        Le jour ou la demo saute, l'etat vide d'origine reprend sa place.
      {%- endcomment -%}
      {%- render 'kn-demo-grid', limit: 8 -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Nouveautés",
  "tag": "section",
  "class": "kn-products-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Dernières pièces"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Nouveautés"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection affichée",
      "info": "Si aucune collection n'est choisie, tous les produits de la boutique sont utilisés."
    },
    {
      "type": "range",
      "id": "count",
      "label": "Nombre de produits",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Libellé du lien de la collection",
      "default": "VOIR TOUT"
    },
    {
      "type": "header",
      "content": "Quand la collection est vide"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Phrase affichée",
      "default": "Les nouveautés de la saison arrivent très bientôt."
    },
    {
      "type": "text",
      "id": "empty_link_label",
      "label": "Libellé du bouton",
      "default": "VOIR TOUS LES PRODUITS"
    }
  ],
  "presets": [
    {
      "name": "KINŪ — Nouveautés"
    }
  ]
}
{% endschema %}
