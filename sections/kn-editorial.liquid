{%- liquid
  assign s = section.settings
  assign source_blog = blogs[s.blog]
  assign article_count = source_blog.articles.size
  assign feature = source_blog.articles.first

  if article_count > 0
    assign feature_url = feature.url
    assign feature_image = feature.image
    assign feature_title = feature.title
    assign feature_excerpt = feature.excerpt_or_content | strip_html | truncatewords: 28
  else
    assign feature_url = s.fallback_url
    assign feature_image = s.fallback_image
    assign feature_title = s.fallback_title
    assign feature_excerpt = s.fallback_text
  endif

  assign head_link_url = source_blog.url | default: s.fallback_url
  assign show_head_link = false
  if s.link_label != blank and head_link_url != blank
    assign show_head_link = true
  endif

  assign alt_text = feature_image.alt | default: feature_title | escape
-%}

{%- if feature_title != blank -%}
  <div class="kn-section" data-kn-surface="sage">
    <div class="kn-container">
      <div class="kn-home-head">
        {%- if s.title != blank -%}
          <h2 class="kn-home-head__title">{{ s.title | escape }}</h2>
        {%- endif -%}
        {%- if show_head_link -%}
          <a class="kn-label kn-underline kn-home-head__link" href="{{ head_link_url }}">
            {{- s.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>

    </div>

    {%- capture feature_content -%}
      {%- comment -%}
        Le cadre n'existe que s'il a une image. Rendu a vide il gardait son
        ratio large sur toute la largeur : une section entiere de vide, ce que
        l'on voyait tant que le blog n'avait aucun article et qu'aucune image
        de repli n'etait reglee.
      {%- endcomment -%}
      {%- if feature_image != blank -%}
        <div class="kn-ratio kn-editorial__frame">
          {{
            feature_image
            | image_url: width: 3200
            | image_tag:
              widths: '640, 828, 1080, 1280, 1600, 1920, 2400, 3200',
              sizes: '100vw',
              class: 'kn-img',
              alt: alt_text,
              loading: 'lazy'
          }}
        </div>
      {%- endif -%}

      <div class="kn-container">
        <div class="kn-editorial__body">
          {%- if article_count > 0 -%}
            <time class="kn-editorial__meta kn-label" datetime="{{ feature.published_at | date: '%Y-%m-%d' }}">
              {{- feature.published_at | date: format: 'abbreviated_date' -}}
            </time>
          {%- endif -%}

          <h3 class="kn-editorial__title">{{ feature_title | escape }}</h3>

          {%- if feature_excerpt != blank -%}
            <p class="kn-body kn-editorial__excerpt">{{ feature_excerpt }}</p>
          {%- endif -%}

          {%- if s.read_label != blank and feature_url != blank -%}
            <span class="kn-label kn-underline kn-editorial__more">{{ s.read_label | escape }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endcapture -%}

    {%- if feature_url != blank -%}
      <a class="kn-editorial__feature kn-home-body kn-reveal" href="{{ feature_url }}">{{ feature_content }}</a>
    {%- else -%}
      <div class="kn-editorial__feature kn-home-body kn-reveal">{{ feature_content }}</div>
    {%- endif -%}

    {%- if article_count > 1 -%}
      <div class="kn-container">
        <ul class="kn-editorial__list" role="list">
          {%- for article in source_blog.articles limit: 2 offset: 1 -%}
            <li class="kn-editorial__item kn-reveal">
              <a class="kn-editorial__link" href="{{ article.url }}">
                <time class="kn-label kn-editorial__item-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{- article.published_at | date: format: 'abbreviated_date' -}}
                </time>
                <h4>{{ article.title | escape }}</h4>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <div class="kn-home-placeholder">
    <p class="kn-label">Choisissez un blog, ou renseignez le bloc éditorial de repli dans les réglages de cette section.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau journal",
  "tag": "section",
  "class": "kn-editorial-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre de la section",
      "default": "Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog affiché",
      "info": "Le dernier article devient la bannière, les deux suivants sont listés en dessous."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Libellé du lien du blog",
      "default": "TOUS LES ARTICLES"
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Libellé de lecture",
      "default": "LIRE L’ARTICLE"
    },
    {
      "type": "header",
      "content": "Bloc de repli (si aucun article n'est publié)"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Image (21:9 sur ordinateur, 4:5 sur mobile)"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Titre",
      "default": "Dans l’atelier : la coupe d’une brassière de course"
    },
    {
      "type": "textarea",
      "id": "fallback_text",
      "label": "Texte",
      "default": "Trois mois de patronage, onze prototypes, et une seule question à chaque essai : est-ce que la pièce se fait oublier une fois lancée ?"
    },
    {
      "type": "url",
      "id": "fallback_url",
      "label": "Destination"
    }
  ],
  "presets": [
    {
      "name": "KINŪ — Bandeau journal"
    }
  ]
}
{% endschema %}
