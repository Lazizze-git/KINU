{%- doc -%}
  KINŪ — Grille de démonstration

  ⚠️ CONTENU DE MAQUETTE, À RETIRER AVANT LA MISE EN LIGNE.
  Les photographies `kn-demo-*.jpg` appartiennent à New Balance × Aimé Leon
  Dore : elles servent uniquement à juger la mise en page tant que le
  catalogue est vide. Les noms et les prix sont inventés.

  Ce bloc ne s'affiche JAMAIS quand la boutique a des produits : il prend la
  place des états vides, là où il n'y avait qu'une phrase.

  @param {number} [limit] - Nombre de cartes. 8 par défaut, 8 disponibles.
  @param {string} [grid_class] - Classe de la grille. `kn-products__grid`
    par défaut ; passer `kn-grid` pour le champ réglé du catalogue.
  @param {string} [heading_tag] - Balise du nom. `h3` par défaut.

  @example
  {% render 'kn-demo-grid', limit: 8, grid_class: 'kn-grid' %}
{%- enddoc -%}

{%- liquid
  assign kn_limit = limit | default: 8
  assign kn_grid_class = grid_class | default: 'kn-products__grid'
  assign kn_tag = heading_tag | default: 'h3'

  assign kn_titles = 'Coupe-vent Ridge|Veste Sillon|Polo Crête|Débardeur Foehn|Poncho Averse|Veste Moraine|Parka Combe|Pantalon Bise' | split: '|'
  assign kn_prices = '240|320|130|75|260|290|380|190' | split: '|'
  assign kn_lines = 'Homme — CrossOver|Homme — CrossOver|Unisexe — Amplitude|Femme — Fluid-Motion|Unisexe — Amplitude|Homme — CrossOver|Unisexe — Amplitude|Femme — Fluid-Motion' | split: '|'
  assign kn_files = 'kn-demo-01.jpg|kn-demo-02.jpg|kn-demo-03.jpg|kn-demo-04.jpg|kn-demo-05.jpg|kn-demo-06.jpg|kn-demo-07.jpg|kn-demo-02.jpg' | split: '|'
  assign kn_badges = 'Nouveau||||Nouveau|||' | split: '|'

  assign kn_is_field = false
  if kn_grid_class == 'kn-grid'
    assign kn_is_field = true
  endif
-%}

{%- if kn_is_field -%}
  <ul class="kn-grid" role="list" data-kn-demo>
{%- else -%}
  <div class="{{ kn_grid_class }} kn-home-body" data-kn-demo>
{%- endif -%}

{%- for kn_i in (1..kn_limit) -%}
  {%- liquid
    assign kn_index = kn_i | minus: 1
    assign kn_pool = kn_titles.size
    if kn_index >= kn_pool
      break
    endif
    assign kn_badge = kn_badges[kn_index]
  -%}

  {%- capture kn_card -%}
    <article class="kn-card">
      <div class="kn-card__link">
        <span class="kn-ratio kn-card__media">
          <img
            class="kn-img kn-card__img"
            src="{{ kn_files[kn_index] | asset_url }}"
            alt="Silhouette de démonstration {{ kn_i }}"
            width="1000"
            height="1600"
            loading="{% if kn_i <= 2 %}eager{% else %}lazy{% endif %}"
          >
          {%- if kn_badge != blank -%}
            <span class="kn-badge kn-label kn-card__badge">{{ kn_badge }}</span>
          {%- endif -%}
        </span>

        <span class="kn-label kn-card__universe">{{ kn_lines[kn_index] }}</span>
        <{{ kn_tag }} class="kn-card__title">{{ kn_titles[kn_index] }}</{{ kn_tag }}>
        <span class="kn-card__prices">
          <span class="kn-price kn-card__price">CHF {{ kn_prices[kn_index] }}.–</span>
        </span>
      </div>
    </article>
  {%- endcapture -%}

  {%- if kn_is_field -%}
    <li class="kn-grid__item kn-marks">{{ kn_card }}</li>
  {%- else -%}
    <div class="kn-reveal">{{ kn_card }}</div>
  {%- endif -%}
{%- endfor -%}

{%- if kn_is_field -%}
  </ul>
{%- else -%}
  </div>
{%- endif -%}

<p class="kn-label kn-demo-note">
  Silhouettes de démonstration — le catalogue n’a pas encore de produits.
</p>
