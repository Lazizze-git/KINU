{%- doc -%}
  Accordéons de la page produit (DA §7.7) : filets 1 px, sans fond, chevron 12 px.
  Matière et Livraison viennent de métachamps, avec repli sur un texte de section.

  @param {object} product
  @param {object} opts
  @param {string} section_id
{%- enddoc -%}

{%- liquid
  comment
    Les metachamps texte enrichi passent par metafield_tag, qui les rend en
    HTML. Lire .value renverrait la structure brute du champ.
  endcomment
  assign kn_material_mf = product.metafields.custom.matiere_entretien
  assign kn_shipping_mf = product.metafields.custom.livraison_retours
-%}

{%- capture kn_material -%}
  {%- if kn_material_mf != blank -%}
    {{- kn_material_mf | metafield_tag -}}
  {%- else -%}
    {{- opts.text_material -}}
  {%- endif -%}
{%- endcapture -%}

{%- capture kn_shipping -%}
  {%- if kn_shipping_mf != blank -%}
    {{- kn_shipping_mf | metafield_tag -}}
  {%- else -%}
    {{- opts.text_shipping -}}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign kn_material = kn_material | strip
  assign kn_shipping = kn_shipping | strip
-%}

<div class="kn-acc">
  {%- if product.description != blank -%}
    <details class="kn-acc__item" name="kn-acc-{{ section_id }}" open>
      <summary class="kn-acc__sum">
        <span class="kn-label">{{ opts.title_description }}</span>
      </summary>
      <div class="kn-acc__body kn-body">{{ product.description }}</div>
    </details>
  {%- endif -%}

  {%- if kn_material != blank -%}
    <details class="kn-acc__item" name="kn-acc-{{ section_id }}">
      <summary class="kn-acc__sum">
        <span class="kn-label">{{ opts.title_material }}</span>
      </summary>
      <div class="kn-acc__body kn-body">{{ kn_material }}</div>
    </details>
  {%- endif -%}

  {%- if kn_shipping != blank -%}
    <details class="kn-acc__item" name="kn-acc-{{ section_id }}">
      <summary class="kn-acc__sum">
        <span class="kn-label">{{ opts.title_shipping }}</span>
      </summary>
      <div class="kn-acc__body kn-body">{{ kn_shipping }}</div>
    </details>
  {%- endif -%}
</div>
