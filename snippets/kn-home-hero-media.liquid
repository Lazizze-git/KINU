{%- doc -%}
  KINŪ — Média de la bannière d'accueil.

  Le poster est un vrai <img> responsive : il est visible pendant le chargement,
  et il EST la bannière sous `prefers-reduced-motion: reduce` (DA §8). Les
  sources vidéo ne sont posées dans le DOM que par kn-home.js, donc rien n'est
  téléchargé quand le mouvement est refusé.

  @param {object} [video] - Vidéo hébergée par Shopify (réglage de type `video`).
  @param {object} [video_url] - Vidéo externe YouTube/Vimeo (réglage `video_url`).
  @param {object} [poster] - Image du poster (réglage `image_picker`).
  @param {string} [poster_alt] - Texte alternatif de repli si l'image n'en porte pas.
{%- enddoc -%}

{%- liquid
  assign poster_image = poster | default: video.preview_image
  # Le texte alternatif d'une image de fichier ne se traduit pas dans Shopify.
  # Hors langue principale, on prend d'abord celui de la section, traduit
  # dans Traduire et adapter (6 novembre 2026).
  if request.locale.primary
    assign alt_text = poster_image.alt | default: poster_alt | default: shop.name | escape
  else
    assign alt_text = poster_alt | default: poster_image.alt | default: shop.name | escape
  endif

  # Sans poster choisi, c'est la première image de la vidéo qui attend : elle
  # se cadre comme la vidéo, au centre, sinon le fondu la ferait sauter.
  assign poster_class = 'kn-img kn-hero__poster'
  if poster == blank and video != blank
    assign poster_class = 'kn-img kn-hero__poster kn-hero__poster--frame'
  endif

  # Un seul MP4, choisi explicitement : le navigateur retient la première
  # source lisible, et l'ordre renvoyé par Shopify n'est pas garanti.
  assign mp4_url = ''
  assign mp4_height = 0
  if video != blank
    for source in video.sources
      if source.format == 'mp4' and source.height > mp4_height and source.height <= 1080
        assign mp4_url = source.url
        assign mp4_height = source.height
      endif
    endfor
    # Versions plus legeres pour les telephones et les connexions lentes :
    # en 1080p, la video d'accueil pese plus de 40 Mo (retour client du
    # 2 novembre 2026 : « il charge super lentement »).
    assign mp4_url_sm = ''
    assign mp4_url_xs = ''
    for source in video.sources
      assign kn_h = source.height | plus: 0
      if source.format == 'mp4' and kn_h == 720
        assign mp4_url_sm = source.url
      endif
      if source.format == 'mp4' and kn_h == 480
        assign mp4_url_xs = source.url
      endif
    endfor

    # En vitrine, Shopify n'expose souvent que le 1080p dans video.sources,
    # alors que le CDN sert aussi les rendus 720p et 480p au meme endroit.
    # Leurs noms suivent un schema fixe (HD-720p-4.5Mbps, SD-480p-1.5Mbps) :
    # on les deduit du nom du 1080p. Si l'un manquait, kn-home.js retombe
    # sur le 1080p a la premiere erreur de lecture.
    if mp4_url contains 'HD-1080p-' and mp4_url contains 'Mbps-'
      assign kn_parts = mp4_url | split: 'HD-1080p-'
      assign kn_tail = kn_parts.last | split: 'Mbps-'
      if mp4_url_sm == blank
        assign mp4_url_sm = kn_parts.first | append: 'HD-720p-4.5Mbps-' | append: kn_tail.last
      endif
      if mp4_url_xs == blank
        assign mp4_url_xs = kn_parts.first | append: 'SD-480p-1.5Mbps-' | append: kn_tail.last
      endif
    endif

    if mp4_url == blank
      for source in video.sources
        if source.format == 'mp4' and mp4_url == blank
          assign mp4_url = source.url
        endif
      endfor
    endif
  endif

  assign embed_url = ''
  if mp4_url == blank and video_url != blank
    if video_url.type == 'youtube'
      assign embed_url = 'https://www.youtube.com/embed/' | append: video_url.id | append: '?autoplay=1&mute=1&loop=1&playlist=' | append: video_url.id | append: '&controls=0&modestbranding=1&rel=0&playsinline=1&disablekb=1'
    elsif video_url.type == 'vimeo'
      assign embed_url = 'https://player.vimeo.com/video/' | append: video_url.id | append: '?autoplay=1&muted=1&loop=1&controls=0&background=1'
    endif
  endif
-%}

{%- if poster_image != blank -%}
  {{
    poster_image
    | image_url: width: 3200
    | image_tag:
      widths: '480, 640, 828, 1080, 1280, 1600, 1920, 2400, 3200',
      sizes: '100vw',
      class: poster_class,
      alt: alt_text,
      loading: 'eager',
      fetchpriority: 'high'
  }}
{%- endif -%}

{%- if mp4_url != blank -%}
  <video
    class="kn-hero__video"
    data-kn-hero-video
    data-kn-src="{{ mp4_url }}"
    {% if mp4_url_sm != blank %}data-kn-src-sm="{{ mp4_url_sm }}"{% endif %}
    {% if mp4_url_xs != blank %}data-kn-src-xs="{{ mp4_url_xs }}"{% endif %}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
    tabindex="-1"
  ></video>
{%- elsif embed_url != blank -%}
  <div
    class="kn-hero__embed"
    data-kn-hero-embed
    data-kn-src="{{ embed_url }}"
    data-kn-title="{{ alt_text }}"
    aria-hidden="true"
  ></div>
{%- endif -%}
