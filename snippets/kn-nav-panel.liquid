{%- doc -%}
  KINŪ — Panneau de navigation

  Plan vert plein, bord à bord : drawer latéral plein écran sur mobile,
  panneau déroulant pleine largeur sous le header sur desktop.
  Voir DIRECTION-ARTISTIQUE.md §3.4 R6, R7 et §7.2.

  Le contenu vient du menu Shopify choisi dans le schéma du header
  (niveau 1 = entrées de premier niveau, niveau 2 = leurs enfants).
  Les sur-titres d'univers viennent des blocs de la section, appariés au
  libellé de l'entrée de premier niveau. Si aucun menu n'est configuré,
  on retombe sur les blocs seuls.

  @param {object} section - La section kn-header qui porte les réglages.

  @example
  {% render 'kn-nav-panel', section: section %}
{%- enddoc -%}

{%- liquid
  assign kn_links = linklists[section.settings.menu].links
  assign kn_utility = linklists[section.settings.utility_menu].links
  assign kn_all_url = section.settings.secondary_link
  if kn_all_url == blank
    assign kn_all_url = routes.all_products_collection_url
  endif
-%}

<div class="kn-nav" id="kn-nav" data-kn-nav>
  <div class="kn-nav__scrim" data-kn-nav-dismiss aria-hidden="true"></div>

  <div class="kn-nav__slot">
    <div
      class="kn-nav__panel"
      data-kn-surface="flood"
      role="dialog"
      aria-modal="true"
      aria-label="{{ section.settings.nav_dialog_label | escape }}"
      data-kn-nav-panel
    >
      <div class="kn-nav__bar">
        <button
          type="button"
          class="kn-nav__close kn-tap"
          data-kn-nav-dismiss
        >
          {%- render 'kn-icon', name: 'close', size: 20 -%}
          <span class="kn-visually-hidden">{{ section.settings.nav_close_label | escape }}</span>
        </button>
      </div>

      {%- comment -%}
        Amendement du 27 aout : une seule liste de rangees a filets, toutes au
        meme corps, chacune fermee par une fleche — navigation et liens de
        service compris. Les grands titres empiles laissaient les trois quarts
        du panneau vides et ne disaient pas ou l'on va.
      {%- endcomment -%}
      <nav class="kn-nav__body">
        <ul class="kn-nav__list" role="list">
          {%- if kn_links.size > 0 -%}
            {%- for kn_link in kn_links -%}
              {%- liquid
                comment
                  Profondeur du rayon. Le compteur ne remplace jamais le
                  libelle : il le suit, atténué.
                endcomment
                assign kn_count = 0
                if kn_link.type == 'collection_link' and kn_link.object != blank
                  assign kn_count = kn_link.object.all_products_count
                endif

                assign kn_overline = ''
                assign kn_key = kn_link.title | downcase | strip
                for kn_block in section.blocks
                  assign kn_block_key = kn_block.settings.label | downcase | strip
                  if kn_block_key == kn_key
                    assign kn_overline = kn_block.settings.overline
                    break
                  endif
                endfor
              -%}
              {%- capture kn_row_aside -%}
                {%- if kn_overline != blank or kn_count > 0 -%}
                  <span class="kn-nav__aside">
                    {%- if kn_overline != blank -%}
                      <span class="kn-nav__overline kn-label" translate="no">
                        {{- kn_overline | escape -}}
                      </span>
                    {%- endif -%}
                    {%- if kn_count > 0 -%}
                      <span class="kn-brk kn-nav__count" translate="no">
                        {%- if kn_count < 10 %}0{% endif %}{{ kn_count -}}
                      </span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endcapture -%}

              <li class="kn-nav__entry">
                {%- if kn_link.links.size > 0 -%}
                  {%- comment -%}
                    Un univers qui a des categories se deplie sur place : le
                    chevron remplace la fleche, et la collection entiere reste
                    joignable par la premiere ligne de la liste.
                  {%- endcomment -%}
                  <details class="kn-nav__fold">
                    <summary class="kn-nav__level1 kn-nav__summary">
                      <span class="kn-nav__name">{{ kn_link.title | escape }}</span>
                      {{ kn_row_aside }}
                      <span class="kn-nav__chevron" aria-hidden="true">
                        {%- render 'kn-icon', name: 'chevron', size: 16 -%}
                      </span>
                    </summary>

                    <ul class="kn-nav__sub" role="list">
                      <li>
                        <a class="kn-nav__level2 kn-nav__level2--all" href="{{ kn_link.url }}">
                          {{- section.settings.label_view_all | escape -}}
                        </a>
                      </li>
                      {%- for kn_child in kn_link.links -%}
                        <li>
                          <a class="kn-nav__level2" href="{{ kn_child.url }}">{{ kn_child.title | escape }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a class="kn-nav__level1" href="{{ kn_link.url }}">
                    <span class="kn-nav__name">{{ kn_link.title | escape }}</span>
                    {{ kn_row_aside }}
                    <span class="kn-nav__arrow" aria-hidden="true">
                      {%- render 'kn-icon', name: 'arrow-right', size: 18 -%}
                    </span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for kn_block in section.blocks -%}
              {%- liquid
                assign kn_url = kn_block.settings.link
                if kn_url == blank
                  assign kn_url = routes.all_products_collection_url
                endif
              -%}
              <li class="kn-nav__entry" {{ kn_block.shopify_attributes }}>
                <a class="kn-nav__level1" href="{{ kn_url }}">
                  <span class="kn-nav__name">{{ kn_block.settings.label | escape }}</span>
                  {%- if kn_block.settings.overline != blank -%}
                    <span class="kn-nav__aside">
                      <span class="kn-nav__overline kn-label" translate="no">
                        {{- kn_block.settings.overline | escape -}}
                      </span>
                    </span>
                  {%- endif -%}
                  <span class="kn-nav__arrow" aria-hidden="true">
                    {%- render 'kn-icon', name: 'arrow-right', size: 18 -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%}
            Les liens de service ferment la meme liste : meme rangee, meme
            filet, corps attenue. Rien ne pend plus sous la navigation.
          {%- endcomment -%}
          <li class="kn-nav__entry kn-nav__entry--service">
            <a class="kn-nav__level1" href="{{ kn_all_url }}">
              <span class="kn-nav__name">{{ section.settings.secondary_label | escape }}</span>
              <span class="kn-nav__arrow" aria-hidden="true">
                {%- render 'kn-icon', name: 'arrow-right', size: 18 -%}
              </span>
            </a>
          </li>

          {%- for kn_link in kn_utility -%}
            <li class="kn-nav__entry kn-nav__entry--service">
              <a class="kn-nav__level1" href="{{ kn_link.url }}">
                <span class="kn-nav__name">{{ kn_link.title | escape }}</span>
                <span class="kn-nav__arrow" aria-hidden="true">
                  {%- render 'kn-icon', name: 'arrow-right', size: 18 -%}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
  </div>
</div>
